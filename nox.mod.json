{
  "type": "mod",
  "id": "nox.users",
  "provides": [
    "fr.hactazia.users",
    "users"
  ],
  "name": "Users",
  "version": "1.0.x",
  "description": "User profile, authentication, and account management API.",
  "license": "GPL-3.0",
  "icon": null,
  "contact": {
    "email": "hactazia@gmail.com",
    "source": "https://github.com/AtelierVR/nox.users",
    "website": "https://nox.hactazia.fr/",
    "issues": "https://github.com/AtelierVR/nox.users/issues"
  },
  "authors": [
    {
      "name": "Hactazia",
      "email": "hactazia@gmail.com",
      "website": "https://hactazia.fr/"
    }
  ],
  "relations": [
    {
      "id": "table",
      "type": "depends",
      "version": ">=1.0.0",
      "register": "git+https://github.com/AtelierVR/nox.table.git"
    },
    {
      "id": "worlds",
      "type": "depends",
      "version": ">=1.0.0",
      "register": "git+https://github.com/AtelierVR/nox.worlds.git"
    },
    {
      "id": "search",
      "type": "recommends",
      "version": ">=1.0.0",
      "register": "git+https://github.com/AtelierVR/nox.search.git"
    },
    {
      "id": "ui",
      "type": "depends",
      "version": ">=1.0.0",
      "register": "git+https://github.com/AtelierVR/nox.ui.git"
    },
    {
      "id": "network",
      "type": "depends",
      "version": ">=1.0.0",
      "register": "git+https://github.com/AtelierVR/nox.network.git"
    }
  ],
  "constraints": [
    {
      "type": "after",
      "id": "ui"
    },
    {
      "type": "after",
      "id": "network"
    }
  ],
  "entrypoints": {
    "main": [
      "Nox.Users.Runtime.Main"
    ],
    "client": [
      "Nox.Users.Runtime.Client"
    ],
    "editor": [
      "Nox.Users.Runtime.Editor.AuthentificationPanel",
      "Nox.Users.Runtime.Editor.EditorUser",
      "Nox.Users.Runtime.Editor.ProfilePanel"
    ]
  }
}
