{
  "type": "mod",
  "id": "api.nox.user",
  "provides": [
    "fr.hactazia.sdk.user",
    "users"
  ],
  "name": "Test Module",
  "version": "1.0.0",
  "description": "Provides the Test API for the game.",
  "license": "GPL-3.0",
  "icon": null,
  "contact": {
    "email": "hactazia@gmail.com",
    "source": "https://github.com/AtelierVR/api.nox.user",
    "website": "https://nox.hactazia.fr/",
    "issues": "https://github.com/AtelierVR/api.nox.user/issues"
  },
  "authors": [
    {
      "name": "Hactazia",
      "email": "hactazia@gmail.com",
      "website": "https://hactazia.fr/"
    }
  ],
  "relations": [
    {
      "id": "nox.servers",
      "type": "depends",
      "version": ">=1.0.0",
      "register": "git+https://github.com/AtelierVR/nox.servers.git"
    },
    {
      "id": "ui",
      "type": "depends",
      "version": ">=1.0.0",
      "register": "git+https://github.com/AtelierVR/nox.ui.git"
    },
    {
      "id": "search",
      "type": "depends",
      "version": ">=1.0.0",
      "register": "git+https://github.com/AtelierVR/nox.search.git"
    },
    {
      "id": "network",
      "type": "depends",
      "version": ">=1.0.0",
      "register": "git+https://github.com/AtelierVR/nox.network.git"
    }
  ],
  "constraints": [
    {
      "type": "after",
      "id": "search"
    }
  ],
  "entrypoints": {
    "main": [
      "api.nox.user.Main"
    ],
    "client": [
      "api.nox.user.Client"
    ],
    "editor": [
      "api.nox.user.EditorUser",
      "api.nox.user.AuthentificationPanel",
      "api.nox.user.ProfilePanel"
    ]
  }
}